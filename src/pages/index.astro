    <!-- JS Scripts -->
    <script is:inline>
        function switchTab(tabId) {
            document.querySelectorAll('.spa-section').forEach(section => {
                section.classList.add('hidden');
            });

            const targetSection = document.getElementById(`section-${tabId}`);
            if (targetSection) {
                targetSection.classList.remove('hidden');
            }

            document.querySelectorAll('.nav-item').forEach(btn => {
                if (btn.getAttribute('data-tab') === tabId) {
                    btn.classList.add('bg-lab-navy', 'text-white');
                    btn.classList.remove('text-lab-muted', 'hover:bg-lab-bg');
                } else {
                    btn.classList.remove('bg-lab-navy', 'text-white');
                    btn.classList.add('text-lab-muted', 'hover:bg-lab-bg');
                }
            });

            closeMobileDrawer();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileDrawer = document.getElementById('mobile-drawer');
        const mobileDrawerContent = document.getElementById('mobile-drawer-content');
        const mobileDrawerClose = document.getElementById('mobile-drawer-close');

        if(mobileMenuBtn) {
            mobileMenuBtn.addEventListener('click', () => {
                mobileDrawer.classList.remove('hidden');
                setTimeout(() => {
                    mobileDrawer.classList.remove('opacity-0');
                    mobileDrawerContent.classList.remove('-translate-x-full');
                }, 10);
            });
        }

        function closeMobileDrawer() {
            if(mobileDrawerContent) {
                mobileDrawerContent.classList.add('-translate-x-full');
                mobileDrawer.classList.add('opacity-0');
                setTimeout(() => {
                    mobileDrawer.classList.add('hidden');
                }, 300);
            }
        }

        if(mobileDrawerClose) mobileDrawerClose.addEventListener('click', closeMobileDrawer);

        function filterProjects(category) {
            const buttons = document.querySelectorAll('.project-filter-btn');
            buttons.forEach(btn => {
                btn.classList.remove('bg-lab-navy', 'text-white');
                btn.classList.add('bg-white', 'text-lab-muted');
            });
            event.target.classList.add('bg-lab-navy', 'text-white');
            event.target.classList.remove('bg-white', 'text-lab-muted');

            const items = document.querySelectorAll('.project-item');
            items.forEach(item => {
                if (category === 'all' || item.getAttribute('data-category') === category) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        const projectsData = {
            'project-1': {
                tag: 'WEB 应用',
                title: '任务管理系统',
                desc: '基于 Astro 与 Tailwind 构建的轻量高效任务管理应用。具备多维度任务分类、标签管理以及每周完成率数据图表统计。',
                img: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=800&auto=format&fit=crop'
            },
            'project-2': {
                tag: 'AI 应用',
                title: 'AI 资料助手',
                desc: '基于 LLM 开发的个人知识库问答工具。支持 PDF、Markdown 文档解析与语义检索。',
                img: 'https://images.unsplash.com/photo-1634017839464-5c339ebe3cb4?q=80&w=800&auto=format&fit=crop'
            },
            'project-3': {
                tag: '个人网站',
                title: '北辰实验室·个人站点',
                desc: '极简克制风格的个人空间，融合侧边固定导航与动态 SPA 模块展示。',
                img: 'https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?q=80&w=800&auto=format&fit=crop'
            },
            'project-4': {
                tag: '小工具',
                title: '灵感记录应用',
                desc: '一款支持极速呼出的便签及想法捕捉应用，无痛分类归档。',
                img: 'https://images.unsplash.com/photo-1517842645767-c639042777db?q=80&w=800&auto=format&fit=crop'
            }
        };

        const modal = document.getElementById('project-modal');

        function openProjectModal(id) {
            const data = projectsData[id];
            if (!data) return;

            document.getElementById('modal-tag').textContent = data.tag;
            document.getElementById('modal-title').textContent = data.title;
            document.getElementById('modal-desc').textContent = data.desc;
            document.getElementById('modal-img').src = data.img;

            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('opacity-0'), 10);
        }

        function closeProjectModal() {
            modal.classList.add('opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        window.onload = function() {
            switchTab('home');

            const canvas = document.getElementById('particle-canvas');
            if (canvas) {
                const ctx = canvas.getContext('2d');
                let width = canvas.width = canvas.parentElement.clientWidth;
                let height = canvas.height = canvas.parentElement.clientHeight;

                let particles = [];
                for (let i = 0; i < 40; i++) {
                    particles.push({
                        x: Math.random() * width,
                        y: Math.random() * height,
                        vx: (Math.random() - 0.5) * 1.2,
                        vy: (Math.random() - 0.5) * 1.2,
                        radius: Math.random() * 2 + 1
                    });
                }

                function draw() {
                    ctx.clearRect(0, 0, width, height);
                    ctx.fillStyle = '#38BDF8';
                    ctx.strokeStyle = 'rgba(56, 189, 248, 0.15)';

                    particles.forEach((p, index) => {
                        p.x += p.vx;
                        p.y += p.vy;

                        if (p.x < 0 || p.x > width) p.vx *= -1;
                        if (p.y < 0 || p.y > height) p.vy *= -1;

                        ctx.beginPath();
                        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                        ctx.fill();

                        for (let j = index + 1; j < particles.length; j++) {
                            let p2 = particles[j];
                            let dist = Math.hypot(p.x - p2.x, p.y - p2.y);
                            if (dist < 80) {
                                ctx.beginPath();
                                ctx.moveTo(p.x, p.y);
                                ctx.lineTo(p2.x, p2.y);
                                ctx.stroke();
                            }
                        }
                    });
                    requestAnimationFrame(draw);
                }
                draw();
            }
        };

        function runAiDemo() {
            const input = document.getElementById('demo-input').value.trim();
            const output = document.getElementById('demo-output');
            if (!input) {
                output.textContent = '// 请先在上方输入框中输入内容...';
                return;
            }
            output.textContent = `[System Protocol Generated]:\n{\n  "role": "Expert Assistant",\n  "task": "${input}",\n  "constraint": "Concise, precise tone",\n  "status": "Ready for LLM Execution"\n}`;
        }

        function handleContactSubmit(e) {
            e.preventDefault();
            alert('消息已发送！');
            e.target.reset();
        }
    </script>

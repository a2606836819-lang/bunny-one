function selectProjectTimeline(projectId) {
    document.querySelectorAll('.timeline-project').forEach(panel => {
        const active = panel.id === `timeline-project-${projectId}`;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);
    });
    document.querySelectorAll('.sub-item').forEach(item => item.classList.toggle('active', item.dataset.projectId === projectId));
}
function selectProjectFromDrawer(projectId, item) {
    document.querySelectorAll('.sub-item').forEach(link => link.classList.toggle('active', link === item));
    const section = document.getElementById('section-projects');
    if (section && section.classList.contains('hidden')) switchTab('projects');
    requestAnimationFrame(() => {
        selectProjectTimeline(projectId);
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });
}

function toggleProjectDirectory() {
    const layout = document.getElementById('desktop-left-layout');
    if (!layout) return;
    const button = document.querySelector('aside.sidebar-main [data-tab="projects"]');
    if (layout.classList.contains('is-open')) {
        layout.classList.remove('is-open', 'is-minimized');
        if (button) button.setAttribute('aria-expanded', 'false');
        return;
    }
    if (document.getElementById('section-projects')?.classList.contains('hidden')) switchTab('projects');
    layout.classList.add('is-open');
    layout.classList.remove('is-minimized');
    requestAnimationFrame(() => { const active = document.querySelector('aside.sidebar-main .nav-item.active'); if (active) moveNavIndicator(active, false); });
    if (button) button.setAttribute('aria-expanded', 'true');
    const activeProject = document.querySelector('.sub-item.active');
    if (activeProject) selectProjectFromDrawer(activeProject.dataset.projectId, activeProject);
}

function closeProjectDirectory() {
    const layout = document.getElementById('desktop-left-layout');
    if (layout) layout.classList.remove('is-open', 'is-minimized');
    const button = document.querySelector('aside.sidebar-main [data-tab="projects"]');
    if (button) button.setAttribute('aria-expanded', 'false');
}

function expandProjectDirectory() {

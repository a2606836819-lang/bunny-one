      --text-inverse: #F8FAFC;

      --brand-navy: #1A2B4C;
      --brand-blue: #2563EB;
      --brand-blue-soft: rgba(37, 99, 235, 0.08);
      --brand-blue-border: rgba(37, 99, 235, 0.2);

      --border-light: #E2E8F0;
      --border-medium: #CBD5E1;

      --status-ok: #10B981;
      --status-warn: #F59E0B;
      --status-filter: #EF4444;

      --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.04);
      --shadow-md: 0 8px 24px -4px rgba(15, 23, 42, 0.06), 0 2px 6px -1px rgba(15, 23, 42, 0.03);
      --shadow-lg: 0 20px 40px -12px rgba(15, 23, 42, 0.08);

      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;

      --font-sans: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Segoe UI", Roboto, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;

      --container-max: 1040px;
      --nav-height: 64px;
    }

    /* ==========================================================================
       2. 基础重置与排版 (Base & Typography)
       ========================================================================== */
    #kg-story, #kg-story *, #kg-story *::before, #kg-story *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    #kg-story {
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    #kg-story {
      font-family: var(--font-sans);
      background-color: var(--bg-page);
      color: var(--text-primary);
      line-height: 1.75;
      overflow-x: hidden;
    }

    #kg-story a {
      color: inherit;
      text-decoration: none;
    }

    #kg-story ul, #kg-story ol {
      list-style: none;
    }

    #kg-story button {
      font-family: inherit;
      cursor: pointer;
      border: none;
      background: none;
    }

    #kg-story .container {
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ==========================================================================
       3. 顶部导航栏 (Sticky Navigation)
       ========================================================================== */
    #kg-story .site-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: var(--nav-height);
      background: rgba(248, 250, 252, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-light);
      z-index: 100;
      transition: box-shadow 0.2s ease;
    }

    #kg-story .site-header.scrolled {
      box-shadow: var(--shadow-sm);
    }

    #kg-story .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 100%;
    }

    #kg-story .brand-link {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    #kg-story .brand-mark {
      width: 28px;
      height: 28px;
      border-radius: 7px;
      background: var(--brand-navy);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    #kg-story .brand-text {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }

    #kg-story .brand-en {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      color: var(--brand-navy);
      text-transform: uppercase;
    }

    #kg-story .brand-cn {
      font-size: 12px;
      color: var(--text-muted);
      font-weight: 500;
    }

    #kg-story .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    #kg-story .nav-links a {
      font-size: 14px;
      font-weight: 500;
      color: var(--text-secondary);
      padding: 6px 2px;
      position: relative;
      transition: color 0.2s ease;
    }

    #kg-story .nav-links a:hover, #kg-story .nav-links a.active {
      color: var(--brand-navy);
    }

    #kg-story .nav-links a.active::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--brand-blue);
      border-radius: 2px;
    }

    #kg-story .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    #kg-story .nav-home-btn {
      font-size: 13px;
      font-weight: 500;
      color: var(--brand-navy);
      background: var(--bg-surface);
      border: 1px solid var(--border-light);
      padding: 6px 14px;
      border-radius: 999px;
      transition: all 0.2s ease;
    }

    #kg-story .nav-home-btn:hover {
      border-color: var(--border-medium);
      background: var(--bg-subtle);
    }

    #kg-story .mobile-menu-btn {
      display: none;
      width: 36px;
      height: 36px;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      color: var(--text-primary);
    }

    #kg-story .mobile-menu-btn:hover {
      background: var(--bg-subtle);
    }

    /* 移动端折叠抽屉 */
    #kg-story .mobile-drawer {
      display: none;
      position: fixed;
      top: var(--nav-height);
      left: 0;
      right: 0;
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-light);
      padding: 16px 24px 24px;
      box-shadow: var(--shadow-md);
      z-index: 99;
      flex-direction: column;
      gap: 14px;
    }

    #kg-story .mobile-drawer.open {
      display: flex;
    }

    #kg-story .mobile-drawer a {
      font-size: 15px;
      font-weight: 500;
      color: var(--text-secondary);
      padding: 8px 0;
      border-bottom: 1px solid var(--bg-subtle);
    }

    #kg-story .mobile-drawer a:last-child {
      border-bottom: none;
    }

    /* ==========================================================================
       4. Hero 首屏 (Hero Section)
       ========================================================================== */
    #kg-story .hero-section {
      position: relative;
      isolation: isolate;
      /* 项目详情嵌在个人网站内容区，不再预留独立站导航栏的高度。 */
      min-height: calc(100dvh - 128px);
      padding: 38px 0 34px;
      overflow: hidden;
      border-bottom: 1px solid var(--border-light);
      background:
        radial-gradient(circle at 92% 12%, rgba(37, 99, 235, 0.075), transparent 28%),
        radial-gradient(circle at 8% 88%, rgba(101, 214, 177, 0.06), transparent 26%),
        linear-gradient(180deg, #FFFFFF 0%, var(--bg-page) 100%);
    }

    #kg-story .hero-section::before {
      content: "";
      position: absolute;
      z-index: -1;
      inset: 0;
      background-image:
        linear-gradient(rgba(26, 43, 76, 0.028) 1px, transparent 1px),
        linear-gradient(90deg, rgba(26, 43, 76, 0.028) 1px, transparent 1px);
      background-size: 36px 36px;
      mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.7), transparent 72%);
      -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.7), transparent 72%);
      pointer-events: none;
    }

    #kg-story .hero-section::after {
      content: "01";
      position: absolute;
      z-index: -1;
      top: 4px;
      right: max(24px, calc((100% - var(--container-max)) / 2));
      color: rgba(26, 43, 76, 0.038);
      font: 700 clamp(120px, 15vw, 210px) / 1 var(--font-mono);
      letter-spacing: -0.09em;
      pointer-events: none;
    }

    #kg-story .hero-section > .container { position: relative; z-index: 1; display: flex; min-height: calc(100dvh - 200px); flex-direction: column; }

    #kg-story .hero-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-bottom: 24px;
    }

    #kg-story .tag-pill {
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 500;
      color: var(--brand-navy);
      background: var(--bg-subtle);
      border: 1px solid var(--border-light);
      padding: 4px 12px;
      border-radius: 999px;
    }

    #kg-story .tag-pill.highlight {
      color: var(--brand-blue);
      background: var(--brand-blue-soft);
      border-color: var(--brand-blue-border);
    }

    #kg-story .hero-title-group {
      max-width: 760px;
      margin-bottom: 0;
    }

    #kg-story .hero-kicker {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--brand-blue);
      margin-bottom: 12px;
    }

    #kg-story .hero-title {
      font-size: clamp(40px, 6vw, 60px);
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.1;
      color: var(--text-primary);
      margin-bottom: 16px;
    }

    #kg-story .hero-subtitle {
      font-size: clamp(20px, 3vw, 26px);
      font-weight: 500;
      color: var(--brand-navy);
      letter-spacing: -0.01em;
      margin-bottom: 20px;
    }

    #kg-story .hero-lead {
      font-size: 17px;
      color: var(--text-secondary);
      line-height: 1.8;
      max-width: 660px;
    }

    /* 真实软件截图展示槽 (不虚构 UI，规范化预留替换路径) */
    #kg-story .screenshot-frame {
      background: var(--bg-surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: 16px;
      box-shadow: var(--shadow-lg);
      margin-bottom: 40px;
    }

    #kg-story .screenshot-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 4px 8px 14px;
      border-bottom: 1px solid var(--bg-subtle);
      margin-bottom: 16px;
      font-size: 12px;
      color: var(--text-muted);
      font-family: var(--font-mono);
    }

    #kg-story .window-dots {
      display: flex;
      gap: 6px;
    }

    #kg-story .window-dots span {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--border-medium);
    }

    #kg-story .screenshot-slot {
      position: relative;
      width: 100%;
      min-height: 360px;
      background: var(--bg-page);
      border: 1.5px dashed var(--border-medium);
      border-radius: var(--radius-md);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 40px 24px;
      overflow: hidden;
    }

    #kg-story .screenshot-slot img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 10px;
    }

    #kg-story .slot-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--brand-navy);
      background: var(--bg-surface);
      border: 1px solid var(--border-light);
      padding: 6px 12px;
      border-radius: 6px;
      margin-bottom: 14px;
      box-shadow: var(--shadow-sm);
    }

    #kg-story .slot-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 6px;
    }

    #kg-story .slot-desc {
      font-size: 13px;
      color: var(--text-muted);
      max-width: 480px;
    }

    #kg-story .slot-path {
      margin-top: 12px;
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--brand-blue);
      background: var(--brand-blue-soft);
      padding: 4px 10px;
      border-radius: 4px;
    }

    #kg-story .scroll-cue {
      display: flex;
      width: 100%;
      align-items: center;
      gap: 12px;
      font-size: 14px;
      font-weight: 500;
      color: var(--text-muted);
      transition: color 0.2s ease;
    }

    #kg-story .scroll-cue::before {
      content: "";
      order: 1;
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, var(--border-light), rgba(226, 232, 240, 0.25));
    }

    #kg-story .scroll-cue span { order: 0; white-space: nowrap; }
    #kg-story .scroll-cue svg { order: 2; transition: transform .2s ease; }

    #kg-story .scroll-cue:hover {
      color: var(--brand-navy);
    }

    #kg-story .scroll-cue:hover svg { transform: translateY(2px); }

    #kg-story .story-guide {
      display: grid;
      grid-template-columns: 210px minmax(0, 1fr);
      gap: 28px;
      margin-top: 34px;
      padding: 22px 0;
      border-top: 1px solid var(--border-light);
      border-bottom: 1px solid var(--border-light);
    }

    #kg-story .story-guide-kicker {
      display: flex;
      align-items: center;
      gap: 9px;
      color: var(--brand-blue);
      font: 600 10px/1.4 var(--font-mono);
      letter-spacing: 0.13em;
    }

    #kg-story .story-guide-kicker i {
      width: 22px;
      height: 1px;
      background: var(--border-medium);
    }

    #kg-story .story-guide-intro p {
      margin-top: 10px;
      color: var(--brand-navy);
      font-size: 14px;
      font-weight: 550;
      line-height: 1.7;
    }

    #kg-story .story-guide-links {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      align-items: stretch;
    }

    #kg-story .story-guide-links a {
      display: grid;
      min-width: 0;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 10px;
      padding: 5px 13px;
      border-left: 1px solid var(--border-light);
      transition: background-color .2s ease, transform .2s ease;
    }

    #kg-story .story-guide-links a:first-child { border-left: 0; }
    #kg-story .story-guide-links a:hover { transform: translateY(-2px); background: rgba(255, 255, 255, .72); }

    #kg-story .story-guide-num {
      align-self: start;
      padding-top: 1px;
      color: #94a3b8;
      font: 500 10px/1.5 var(--font-mono);
    }

    #kg-story .story-guide-copy { display: block; min-width: 0; }
    #kg-story .story-guide-copy strong { display: block; color: var(--brand-navy); font-size: 13px; font-weight: 650; }
    #kg-story .story-guide-copy small { display: block; margin-top: 3px; overflow: hidden; color: var(--text-muted); font-size: 10.5px; text-overflow: ellipsis; white-space: nowrap; }

    #kg-story .story-guide-links svg {
      width: 14px;
      height: 14px;
      fill: none;
      stroke: #94a3b8;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: stroke .2s ease, transform .2s ease;
    }

    #kg-story .story-guide-links a:hover svg { transform: translateX(2px); stroke: var(--brand-blue); }
    #kg-story .scroll-cue { margin-top: auto; padding-top: 24px; }

    /* ==========================================================================
       5. 通用章节布局 (Story Chapters)
       ========================================================================== */
    #kg-story .story-section {
      padding: 96px 0;
      border-bottom: 1px solid var(--border-light);
    }

    #kg-story .story-section.alt-bg {
      background: var(--bg-surface);
    }

    #kg-story .chapter-header {
      max-width: 700px;
      margin-bottom: 48px;
    }

    #kg-story .chapter-num {
      font-family: var(--font-mono);
      font-size: 13px;
      font-weight: 600;
      color: var(--brand-blue);
      letter-spacing: 0.06em;
      margin-bottom: 10px;
      display: block;
    }

    #kg-story .chapter-title {
      font-size: clamp(28px, 4vw, 36px);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.25;
      color: var(--text-primary);
      margin-bottom: 18px;
    }

    #kg-story .chapter-prose {
      font-size: 16.5px;
      color: var(--text-secondary);
      line-height: 1.85;
    }

    #kg-story .chapter-prose p + p {
      margin-top: 16px;
    }

    /* ==========================================================================
       6. 第二章：输入事件原理示意图 (Principle Diagram)
       ========================================================================== */
    #kg-story .principle-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: 32px;
      box-shadow: var(--shadow-md);
      margin-top: 36px;
    }

    #kg-story .principle-header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 28px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--bg-subtle);
    }

    #kg-story .principle-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
    }

    #kg-story .principle-note {
      font-size: 12px;
      color: var(--text-muted);
      background: var(--bg-subtle);
      padding: 4px 10px;
      border-radius: 999px;
    }

    #kg-story .timeline-demo-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 28px;
    }

    #kg-story .signal-row {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    #kg-story .signal-label {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-secondary);
    }

    #kg-story .signal-track {
      position: relative;
      height: 54px;
      background: var(--bg-page);
      border: 1px solid var(--border-light);
      border-radius: 10px;
      display: flex;
      align-items: center;
      padding: 0 20px;
      overflow: hidden;
    }

    #kg-story .signal-line {
      position: absolute;
      left: 20px;
      right: 20px;
      height: 1px;
      background: var(--border-medium);
      z-index: 1;
    }

    #kg-story .pulse-nodes {
      position: relative;
      z-index: 2;
      width: 100%;
      display: flex;
      align-items: center;
    }

    #kg-story .pulse-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--bg-surface);
      border: 1px solid var(--border-medium);
      padding: 5px 10px;
      border-radius: 6px;
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-primary);
      box-shadow: var(--shadow-sm);
    }

    #kg-story .pulse-item.normal {
      border-color: rgba(16, 185, 129, 0.4);
    }

    #kg-story .pulse-item.normal::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--status-ok);
    }

    #kg-story .pulse-item.filtered {
      border-color: rgba(239, 68, 68, 0.45);
      background: #FEF2F2;
      color: #991B1B;
      text-decoration: line-through;
    }

    #kg-story .pulse-item.filtered::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--status-filter);
    }

    #kg-story .pulse-gap-normal {
      flex: 1;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-muted);
    }

    #kg-story .pulse-gap-short {
      padding: 0 8px;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--status-filter);
      font-weight: 600;
    }

    /* ==========================================================================
       7. 第三章：技术探索与流程图 (Technical Exploration & Flow)
       ========================================================================== */
    #kg-story .tech-concepts {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 14px;
      margin: 32px 0 44px;
    }

    #kg-story .concept-chip {
      background: var(--bg-page);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-sm);
      padding: 14px 16px;
      transition: border-color 0.2s ease;
    }

    #kg-story .concept-chip:hover {
      border-color: var(--brand-blue-border);
    }

    #kg-story .concept-name {
      font-family: var(--font-mono);
      font-size: 13px;
      font-weight: 600;
      color: var(--brand-navy);
      margin-bottom: 4px;
    }

    #kg-story .concept-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* 技术流程图 */
    #kg-story .flow-wrapper {
      background: var(--bg-page);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: 32px 24px;
    }

    #kg-story .flow-caption {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 24px;
      text-align: center;
    }

    #kg-story .flow-pipeline {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    #kg-story .flow-node {
      background: var(--bg-surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-sm);
      padding: 14px 18px;
      min-width: 135px;
      text-align: center;
      box-shadow: var(--shadow-sm);
    }

    #kg-story .flow-node.core {
      border-color: var(--brand-blue-border);
      background: var(--brand-blue-soft);
    }

    #kg-story .flow-node-step {
      display: block;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-muted);
      margin-bottom: 4px;
    }

    #kg-story .flow-node-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
    }

    #kg-story .flow-arrow {
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #kg-story .flow-branch {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    #kg-story .branch-item {
      font-size: 13px;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid var(--border-light);
      background: var(--bg-surface);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    #kg-story .branch-item.pass {
      color: #065F46;
      border-color: rgba(16, 185, 129, 0.35);
      background: #ECFDF5;
    }

    #kg-story .branch-item.block {
      color: #991B1B;
      border-color: rgba(239, 68, 68, 0.35);
      background: #FEF2F2;
    }

    /* ==========================================================================
       8. 第四章：开发挑战时间轴 (Development Challenges Timeline)
       ========================================================================== */
    #kg-story .challenges-timeline {
      position: relative;
      padding-left: 32px;
      margin-top: 40px;
    }

    #kg-story .challenges-timeline::before {
      content: "";
      position: absolute;
      left: 7px;
      top: 8px;
      bottom: 8px;
      width: 2px;
      background: var(--border-light);
    }

    #kg-story .challenge-item {
      position: relative;
      background: var(--bg-surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      padding: 26px 28px;
      margin-bottom: 24px;
      box-shadow: var(--shadow-sm);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    #kg-story .challenge-item:last-child {
      margin-bottom: 0;
    }

    #kg-story .challenge-item:hover {
      box-shadow: var(--shadow-md);
    }

    #kg-story .challenge-item::before {
      content: "";
      position: absolute;
      left: -31px;
      top: 30px;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--bg-surface);
      border: 3px solid var(--brand-blue);
    }

    #kg-story .challenge-tag {
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 600;
      color: var(--brand-blue);
      margin-bottom: 6px;
      display: block;
    }

    #kg-story .challenge-title {
      font-size: 18px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 10px;
    }

    #kg-story .challenge-body {
      font-size: 15px;
      color: var(--text-secondary);
      line-height: 1.75;
    }

    /* ==========================================================================
       9. 第五章：产品实现与双视图截图槽 (Product Implementation)
       ========================================================================== */
    #kg-story .feature-checklist {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: 16px;
      margin: 32px 0 44px;
    }

    #kg-story .feature-box {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      background: var(--bg-page);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-sm);
      padding: 16px;
    }

    #kg-story .feature-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--brand-navy);
      margin-top: 7px;
      flex-shrink: 0;
    }

    #kg-story .feature-text {
      font-size: 14.5px;
      font-weight: 500;
      color: var(--text-primary);
    }

    #kg-story .dual-screenshots {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    #kg-story .dual-screenshots .screenshot-slot {
      min-height: 280px;
      padding: 28px 20px;
    }

    /* ==========================================================================
       10. 第六章：工程化节点 (Engineering Maturity)
       ========================================================================== */
    #kg-story .eng-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: 36px;
    }

    #kg-story .eng-node {
      background: var(--bg-surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      padding: 22px;
    }

    #kg-story .eng-node-num {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 8px;
      display: block;
    }

    #kg-story .eng-node-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--brand-navy);
      margin-bottom: 6px;
    }

    #kg-story .eng-node-desc {
      font-size: 13.5px;
      color: var(--text-secondary);
      line-height: 1.65;
    }

    /* ==========================================================================
       11. 第七章：最终成果展示卡 (Final Outcome Card)
       ========================================================================== */
    #kg-story .outcome-card {
      background: var(--bg-page);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: 44px;
      box-shadow: var(--shadow-md);
      margin-top: 36px;
    }

    #kg-story .outcome-top {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-start;
      gap: 24px;
      padding-bottom: 32px;
      border-bottom: 1px solid var(--border-light);
      margin-bottom: 32px;
    }

    #kg-story .outcome-product-name {
      font-size: 28px;
      font-weight: 700;
      color: var(--text-primary);
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }

    #kg-story .outcome-slogan {
      font-size: 16px;
      color: var(--brand-navy);
      font-weight: 500;
    }

    #kg-story .outcome-version-badge {
      font-family: var(--font-mono);
      font-size: 13px;
      font-weight: 600;
      color: var(--brand-blue);
      background: var(--brand-blue-soft);
      border: 1px solid var(--brand-blue-border);
      padding: 6px 14px;
      border-radius: 999px;
    }

    #kg-story .specs-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 32px;
      margin-bottom: 36px;
    }

    #kg-story .spec-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    #kg-story .spec-label {
      font-size: 12.5px;
      color: var(--text-muted);
      font-weight: 500;
    }

    #kg-story .spec-value {
      font-size: 15.5px;
      color: var(--text-primary);
      font-weight: 600;
    }

    #kg-story .outcome-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    #kg-story .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--brand-navy);
      color: #FFFFFF;
      font-size: 15px;
      font-weight: 500;
      padding: 12px 24px;
      border-radius: 10px;
      transition: background 0.2s ease, transform 0.15s ease;
    }

    #kg-story .btn-primary:hover {
      background: #111D35;
      transform: translateY(-1px);
    }

    #kg-story .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--bg-surface);
      color: var(--text-primary);
      border: 1px solid var(--border-medium);
      font-size: 15px;
      font-weight: 500;
      padding: 12px 24px;
      border-radius: 10px;
      transition: background 0.2s ease, border-color 0.2s ease;
    }

    #kg-story .btn-secondary:hover {
      background: var(--bg-subtle);
      border-color: var(--text-muted);
    }

    /* ==========================================================================
       12. 第八章：项目总结与落款 (Closing Reflection)
       ========================================================================== */
    #kg-story .closing-box {
      max-width: 680px;
    }

    #kg-story .closing-text {
      font-size: 17.5px;
      color: var(--text-secondary);
      line-height: 1.9;
      margin-bottom: 36px;
    }

    #kg-story .closing-text p + p {
      margin-top: 18px;
    }

    #kg-story .signature-block {
      padding-top: 24px;
      border-top: 1px solid var(--border-light);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    #kg-story .signature-author {
      font-size: 18px;
      font-weight: 700;
      color: var(--text-primary);
    }

    #kg-story .signature-brand {
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--text-muted);
      letter-spacing: 0.06em;
    }

    /* ==========================================================================
       13. 页脚与返回顶部 (Footer & Back to Top)
       ========================================================================== */
    #kg-story .site-footer {
      padding: 48px 0;
      background: var(--bg-surface);
      font-size: 13.5px;
      color: var(--text-muted);
    }

    #kg-story .footer-inner {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }

    #kg-story .footer-links {
      display: flex;
      gap: 24px;
    }

    #kg-story .footer-links a:hover {
      color: var(--brand-navy);
    }

    #kg-story .back-to-top {
      position: fixed;
      right: 24px;
      bottom: 24px;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: var(--bg-surface);
      border: 1px solid var(--border-light);
      color: var(--brand-navy);
      box-shadow: var(--shadow-md);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transform: translateY(10px);
      transition: all 0.25s ease;
      z-index: 90;
    }

    #kg-story .back-to-top.visible {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    #kg-story .back-to-top:hover {
      background: var(--brand-navy);
      color: #FFFFFF;
    }

    /* ==========================================================================
       14. 滚动渐入动效 (Subtle Reveal Animation)
       ========================================================================== */
    #kg-story .reveal {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #kg-story .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ==========================================================================
       15. 响应式适配 (Responsive Design)
       ========================================================================== */
    @media (max-width: 860px) {
      #kg-story .story-guide { grid-template-columns: 1fr; gap: 18px; }
      #kg-story .story-guide-intro { display: flex; align-items: center; justify-content: space-between; gap: 18px; }
      #kg-story .story-guide-intro p { margin-top: 0; text-align: right; }

      #kg-story .eng-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      #kg-story .dual-screenshots {
        grid-template-columns: 1fr;
      }

      #kg-story .flow-pipeline {
        flex-direction: column;
      }

      #kg-story .flow-arrow {
        transform: rotate(90deg);
      }
    }

    @media (max-width: 680px) {
      #kg-story .hero-section { min-height: auto; padding: 30px 0 28px; }
      #kg-story .hero-section > .container { min-height: 0; }
      #kg-story .hero-section::after { display: none; }
      #kg-story .story-guide { margin-top: 28px; padding: 18px 0; }
      #kg-story .story-guide-intro { display: block; }
      #kg-story .story-guide-intro p { margin-top: 8px; text-align: left; }
      #kg-story .story-guide-links { display: flex; gap: 8px; margin-right: -24px; padding-right: 24px; overflow-x: auto; scrollbar-width: none; overscroll-behavior-inline: contain; }
      #kg-story .story-guide-links::-webkit-scrollbar { display: none; width: 0; height: 0; }
      #kg-story .story-guide-links a { flex: 0 0 168px; padding: 12px; border: 1px solid var(--border-light); border-radius: 12px; background: rgba(255, 255, 255, .78); }
      #kg-story .story-guide-links a:first-child { border: 1px solid var(--border-light); }

      #kg-story .nav-links, #kg-story .nav-home-btn {
        display: none;
      }

      #kg-story .mobile-menu-btn {
        display: flex;
      }

      #kg-story .story-section {
        padding: 68px 0;
      }

      #kg-story .eng-grid, #kg-story .specs-grid {
        grid-template-columns: 1fr;
      }

      #kg-story .outcome-card {
        padding: 28px 22px;
      }

      #kg-story .challenges-timeline {
        padding-left: 24px;
      }

      #kg-story .challenge-item {
        padding: 20px;
      }

      #kg-story .challenge-item::before {
        left: -23px;
      }
    }
  

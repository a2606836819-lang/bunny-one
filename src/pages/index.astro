---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>北辰实验室 — NORTHSTAR LAB | 孙国钦的个人空间</title>

    <!-- Font Awesome 图标库 (使用 cdnjs 静态资源) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Google 字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Inter:wght@300;400;500;600;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Noto Sans SC"', 'Inter', 'sans-serif'],
                        handwriting: ['Caveat', 'cursive'],
                    },
                    colors: {
                        lab: {
                            bg: '#F7F8FA',
                            card: '#FFFFFF',
                            text: '#1A1D20',
                            muted: '#64748B',
                            subtle: '#94A3B8',
                            border: '#E2E8F0',
                            navy: '#1A2B4C',
                            navyHover: '#0F172A',
                            accent: '#2563EB',
                            pill: '#EEF2F6',
                        }
                    },
                    boxShadow: {
                        'subtle': '0 1px 3px 0 rgba(0, 0, 0, 0.02), 0 1px 2px 0 rgba(0, 0, 0, 0.04)',
                        'hover-card': '0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.04)',
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #F7F8FA;
        }
        ::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94A3B8;
        }

        .handwritten-text {
            font-family: 'Caveat', cursive;
            transform: rotate(-6deg);
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
    </style>
</head>
<body class="bg-lab-bg text-lab-text font-sans antialiased min-h-screen flex flex-col md:flex-row selection:bg-lab-navy selection:text-white">

    <!-- Mobile Top Header Bar -->
    <header class="md:hidden sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-lab-border px-5 py-4 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
            <svg class="w-6 h-6 text-lab-navy" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"/>
            </svg>
            <div class="flex flex-col">
                <span class="font-bold text-sm tracking-wider text-lab-text">北辰实验室</span>
                <span class="text-[9px] font-semibold tracking-widest text-lab-subtle uppercase">NORTHSTAR LAB</span>
            </div>
        </div>
        <button id="mobile-menu-btn" class="p-2 text-lab-text focus:outline-none" aria-label="Toggle Navigation">
            <i class="fa-solid fa-bars text-xl"></i>
        </button>
    </header>

    <!-- Mobile Drawer Navigation -->
    <div id="mobile-drawer" class="fixed inset-0 bg-black/40 z-50 hidden opacity-0 transition-opacity duration-300 md:hidden">
        <div id="mobile-drawer-content" class="bg-white w-3/4 max-w-xs h-full p-6 flex flex-col justify-between transform -translate-x-full transition-transform duration-300">
            <div>
                <div class="flex items-center justify-between pb-6 border-b border-lab-border">
                    <div class="flex items-center gap-2">
                        <svg class="w-6 h-6 text-lab-navy" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"/>
                        </svg>
                        <span class="font-bold text-sm">北辰实验室</span>
                    </div>
                    <button id="mobile-drawer-close" class="text-lab-muted hover:text-lab-text">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>
                <nav class="mt-6 flex flex-col gap-2">
                    <button onclick="switchTab('home')" class="mobile-nav-btn text-left px-4 py-3 rounded-lg text-sm font-medium transition-all flex items-center gap-3">
                        <i class="fa-regular fa-compass w-5"></i> 首页
                    </button>
                    <button onclick="switchTab('projects')" class="mobile-nav-btn text-left px-4 py-3 rounded-lg text-sm font-medium transition-all flex items-center gap-3">
                        <i class="fa-regular fa-folder w-5"></i> 我的项目
                    </button>
                    <button onclick="switchTab('experiments')" class="mobile-nav-btn text-left px-4 py-3 rounded-lg text-sm font-medium transition-all flex items-center gap-3">
                        <i class="fa-solid fa-flask w-5"></i> 技术实验
                    </button>
                    <button onclick="switchTab('logs')" class="mobile-nav-btn text-left px-4 py-3 rounded-lg text-sm font-medium transition-all flex items-center gap-3">
                        <i class="fa-regular fa-bookmark w-5"></i> 学习日志
                    </button>
                    <button onclick="switchTab('about')" class="mobile-nav-btn text-left px-4 py-3 rounded-lg text-sm font-medium transition-all flex items-center gap-3">
                        <i class="fa-regular fa-user w-5"></i> 关于我
                    </button>
                </nav>
            </div>
            <div class="border-t border-lab-border pt-4 text-xs text-lab-muted space-y-2">
                <p>—<br>从想法出发，以技术构建，让创造真正发生。</p>
                <p class="text-emerald-600 flex items-center gap-1.5 font-medium">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> 持续探索中
                </p>
            </div>
        </div>
    </div>

    <!-- LEFT SIDEBAR (Desktop Fixed) -->
    <aside id="desktop-left-layout" class="sidebar-shell hidden md:flex h-screen sticky top-0 shrink-0 z-30 select-none">
        <div class="sidebar-ambient-glow" id="sidebar-ambient-glow"></div>
        <div class="sidebar-main" id="main-sidebar">
        <div class="space-y-10 relative z-[1]">
            <a href="javascript:void(0)" onclick="switchTab('home')" class="flex items-center gap-3 group">
                <div class="w-8 h-8 rounded-lg bg-lab-navy flex items-center justify-center text-white transition-transform group-hover:scale-105">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"/>
                    </svg>
                </div>
                <div class="flex flex-col">
                    <span class="font-bold text-base tracking-wide text-lab-text leading-tight">北辰实验室</span>
                    <span class="text-[9px] font-mono tracking-widest text-lab-subtle uppercase">NORTHSTAR LAB</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="sidebar-nav relative flex flex-col gap-1.5" id="sidebar-nav">
                <div class="nav-indicator" id="nav-indicator" aria-hidden="true"><span class="indicator-bar"></span><span class="indicator-shine"></span></div>
                <button onclick="switchTab('home')" data-tab="home" class="nav-item active flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-lab-muted hover:text-lab-text hover:bg-lab-bg transition-all text-left">
                    <svg class="sidebar-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5L12 3l9 7.5M5 9.5V21h14V9.5"/></svg>
                    <span>首页</span>
                </button>

                <button onclick="toggleProjectDirectory()" data-tab="projects" aria-expanded="false" aria-controls="project-sidebar" class="nav-item flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-lab-muted hover:text-lab-text hover:bg-lab-bg transition-all text-left">
                    <svg class="sidebar-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                    <span>我的项目</span>
                </button>

                <button onclick="switchTab('experiments')" data-tab="experiments" class="nav-item flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-lab-muted hover:text-lab-text hover:bg-lab-bg transition-all text-left">
                    <svg class="sidebar-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 2v7.31M14 2v7.31M8.5 2h7M14 9.3a6.5 6.5 0 1 1-4 0M5.52 16h12.96"/></svg>
                    <span>技术实验</span>
                </button>

                <button onclick="switchTab('logs')" data-tab="logs" class="nav-item flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-lab-muted hover:text-lab-text hover:bg-lab-bg transition-all text-left">
                    <svg class="sidebar-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    <span>学习日志</span>
                </button>

                <button onclick="switchTab('about')" data-tab="about" class="nav-item flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-lab-muted hover:text-lab-text hover:bg-lab-bg transition-all text-left">
                    <svg class="sidebar-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/></svg>
                    <span>关于我</span>
                </button>
            </nav>
        </div>

        <div class="relative z-[1] space-y-6 pt-6 border-t border-lab-border">
            <div class="space-y-3">
                <span class="block text-lab-subtle font-serif">—</span>
                <p class="text-xs text-lab-muted leading-relaxed">
                    从想法出发，<br>
                    以技术构建，<br>
                    让创造真正发生。
                </p>
                <div class="flex items-center gap-2 text-xs text-slate-700 font-medium">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>持续探索中</span>
                </div>
            </div>

            <div class="flex items-center gap-4 text-lab-muted text-sm pt-2">
                <a href="https://github.com" target="_blank" rel="noopener" class="hover:text-lab-text transition-colors" title="GitHub">
                    <i class="fa-brands fa-github"></i>
                </a>
                <a href="mailto:contact@northstarlab.com" class="hover:text-lab-text transition-colors" title="Email">
                    <i class="fa-regular fa-envelope"></i>
                </a>
                <a href="javascript:void(0)" onclick="alert('RSS Feed: https://northstarlab.io/rss.xml')" class="hover:text-lab-text transition-colors" title="RSS Feed">
                    <i class="fa-solid fa-rss"></i>
                </a>
            </div>
        </div>
        </div>
        <aside class="sidebar-projects" id="project-sidebar" aria-label="项目二级目录">
            <button type="button" class="drawer-handle" aria-label="重新展开项目目录" onclick="expandProjectDirectory()"><span></span></button>
            <div class="projects-inner">
                <div class="project-title">项目库 <span>PROJECTS</span></div>
                <button type="button" class="sub-item active" data-project-id="northstar" onclick="selectProjectFromDrawer('northstar', this)"><span class="sub-date">2026.11 — 现在</span><span class="sub-title">北辰实验室</span><span class="sub-info">个人技术作品集与实验平台</span></button>
                <button type="button" class="sub-item" data-project-id="task" onclick="selectProjectFromDrawer('task', this)"><span class="sub-date">2025.09</span><span class="sub-title">任务管理系统</span><span class="sub-info">基于 Astro 的轻量级 Web 应用</span></button>
                <button type="button" class="sub-item" data-project-id="ai" onclick="selectProjectFromDrawer('ai', this)"><span class="sub-date">2025.08</span><span class="sub-title">AI 资料助手</span><span class="sub-info">大模型驱动的知识整理与问答</span></button>
                <button type="button" class="sub-item" data-project-id="ideas" onclick="selectProjectFromDrawer('ideas', this)"><span class="sub-date">2025.06</span><span class="sub-title">灵感记录应用</span><span class="sub-info">随时捕捉想法的个人小工具</span></button>
            </div>
        </aside>
    </aside>

    <!-- MAIN CONTENT CONTAINER -->
    <main id="main-content" class="flex-1 min-w-0 bg-lab-bg p-6 md:p-12 lg:p-16 max-w-7xl mx-auto w-full relative">
        <button id="version-history-trigger" type="button" onclick="openVersionHistory()" aria-haspopup="dialog" aria-controls="version-history-modal" class="version-trigger absolute top-6 right-6 md:top-10 md:right-12 inline-flex items-center gap-2 rounded-full border border-lab-border bg-white/80 px-3.5 py-2 text-[11px] font-mono tracking-wide text-lab-muted shadow-sm backdrop-blur-sm">
            <span class="version-indicator" aria-hidden="true"></span>
            <span>v0.9.0</span>
            <span class="version-trigger-label">更新记录 <i class="fa-solid fa-arrow-up-right-from-square ml-1 text-[9px]"></i></span>
        </button>

        <!-- SECTION 1: 首页 -->
        <section id="section-home" class="spa-section space-y-16 animate-fadeIn">
            <div class="space-y-6 max-w-3xl pt-2">
                <div class="text-xs font-mono tracking-widest text-lab-subtle uppercase">HELLO, I'M</div>

                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-lab-text tracking-tight leading-tight">
                    你好，我是孙国钦。<br>
                    欢迎来到我的个人空间。
                </h1>

                <p class="text-sm sm:text-base text-lab-muted leading-relaxed space-y-2">
                    我有工业设计背景，做过产品结构相关工作，也接触过界面设计和 VBA 编程。现在，我也参与父亲的建筑与水利工程相关业务。<br class="hidden sm:block">
                    一路走来，我始终对设计、技术以及创造事物的过程抱有兴趣。<br class="hidden sm:block">
                    比起重复既有的工作模式，我更喜欢安静地研究问题、寻找方法，再亲手把一个想法做成可以使用的东西。
                </p>

                <p class="text-xs sm:text-sm text-lab-subtle leading-relaxed">
                    我不希望自己只是新技术的使用者。我想理解它们、驾驭它们，并借助 AI 和技术，把脑海中的想法逐渐变成真实的产品。<br>
                    开始做这个网站后，我第一次明显感受到目标变得清晰，也找回了继续学习和动手创造的动力。
                </p>

                <div class="pt-2 flex flex-wrap gap-3">
                    <button onclick="switchTab('projects')" class="home-cta inline-flex items-center gap-3 px-6 py-3 rounded-full bg-lab-navy hover:bg-lab-navyHover text-white text-xs sm:text-sm font-medium transition-all shadow-sm hover:shadow-md">
                        <span>查看我的项目与练习</span>
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                    <button onclick="switchTab('about')" class="home-cta home-cta-secondary inline-flex items-center gap-3 px-6 py-3 rounded-full bg-white text-lab-navy border border-lab-border hover:bg-lab-bg text-xs sm:text-sm font-medium transition-all shadow-sm hover:shadow-md">
                        <span>了解我</span>
                        <i class="fa-regular fa-user text-xs"></i>
                    </button>
                </div>
            </div>

            <!-- Visual Banner -->
            <div class="relative w-full h-64 sm:h-80 md:h-96 rounded-2xl overflow-hidden shadow-sm border border-lab-border group">
                <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=1600&auto=format&fit=crop"
                     alt="Landscape Background"
                     class="w-full h-full object-cover object-center filter brightness-[0.95] group-hover:scale-105 transition-transform duration-700">

                <div class="absolute top-6 right-8 text-white/80 handwritten-text text-2xl sm:text-4xl pointer-events-none drop-shadow">
                    Better Tools<br>&nbsp;&nbsp;&nbsp;&nbsp;Bigger Dreams
                </div>

                <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent pointer-events-none"></div>
            </div>

            <!-- PRACTICE PRINCIPLES -->
            <div class="space-y-6 pt-2">
                <div class="flex items-end justify-between gap-4 border-b border-lab-border/80 pb-4">
                    <div>
                        <div class="text-[10px] font-mono tracking-widest text-lab-subtle uppercase mb-2">MY PRACTICE</div>
                        <h2 class="text-xl font-bold text-lab-text">我想逐步练成的三种能力</h2>
                    </div>
                    <span class="hidden sm:block text-xs text-lab-subtle">从想法到可验证的产品</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <article class="bg-white rounded-2xl p-5 border border-lab-border shadow-subtle">
                        <span class="text-xs font-mono text-lab-subtle">01 / FIND</span>
                        <h3 class="mt-3 text-sm font-bold text-lab-text">把问题说清楚</h3>
                        <p class="mt-2 text-xs text-lab-muted leading-relaxed">从真实场景出发，弄明白谁遇到了什么麻烦，再决定要不要做功能。先验证问题，避免一开始就被工具和技术带着走。</p>
                    </article>
                    <article class="bg-white rounded-2xl p-5 border border-lab-border shadow-subtle">
                        <span class="text-xs font-mono text-lab-subtle">02 / MAKE</span>
                        <h3 class="mt-3 text-sm font-bold text-lab-text">尽快做出小原型</h3>
                        <p class="mt-2 text-xs text-lab-muted leading-relaxed">把设计、代码和 AI 工具组合起来，先完成最小的可体验版本。用具体界面和操作检验想法，而不是只停留在概念描述里。</p>
                    </article>
                    <article class="bg-white rounded-2xl p-5 border border-lab-border shadow-subtle">
                        <span class="text-xs font-mono text-lab-subtle">03 / LEARN</span>
                        <h3 class="mt-3 text-sm font-bold text-lab-text">记录取舍与下一步</h3>
                        <p class="mt-2 text-xs text-lab-muted leading-relaxed">写下遇到的问题、采用的方案和仍然不确定的地方。每次实践都留下可以复用的经验，也让下一轮迭代更有方向。</p>
                    </article>
                </div>
            </div>
            <!-- Featured Projects Section -->
            <div class="space-y-8 pt-4">
                <div class="flex items-center justify-between border-b border-lab-border/80 pb-4">
                    <div class="flex items-baseline gap-3">
                        <h2 class="text-xl font-bold text-lab-text">我的项目</h2>
                        <span class="text-xs font-mono text-lab-subtle">Featured Projects</span>
                    </div>
                    <button onclick="switchTab('projects')" class="text-xs font-medium text-lab-muted hover:text-lab-navy flex items-center gap-1 transition-colors">
                        <span>查看全部项目</span>
                        <i class="fa-solid fa-arrow-right text-[10px]"></i>
                    </button>
                </div>

                <p class="-mt-4 max-w-3xl text-xs text-lab-muted leading-relaxed">当前整理的四个项目方向分别关注个人任务管理、知识整理、个人表达与灵感捕捉。它们也是我练习把需求、界面和实现连成一条路径的记录。</p>

                <!-- 2x2 Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div onclick="openProjectModal('project-1')" class="bg-white rounded-2xl p-6 border border-lab-border shadow-subtle hover:shadow-hover-card transition-all duration-300 cursor-pointer flex flex-col justify-between group">
                        <div class="space-y-4">
                            <div class="h-44 rounded-xl bg-slate-50 border border-slate-100 overflow-hidden relative flex items-center justify-center">
                                <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=800&auto=format&fit=crop"
                                     alt="任务管理系统" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                <div class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-white/90 backdrop-blur-sm text-[10px] font-mono font-medium text-lab-muted border border-slate-200">
                                    Web 应用
                                </div>
                            </div>

                            <div class="space-y-2">
                                <h3 class="text-base font-bold text-lab-text group-hover:text-lab-navy transition-colors">任务管理系统</h3>
                                <p class="text-xs text-lab-muted leading-relaxed line-clamp-2">
                                    基于 Astro 构建的轻量级任务管理工具，支持任务分类、标签管理和数据统计，帮助我更高效地规划工作与学习。
                                </p>
                            </div>
                        </div>

                        <div class="pt-4 mt-2 flex items-center justify-between text-xs text-lab-subtle border-t border-slate-100">
                            <span class="font-mono">2025.09</span>
                            <span class="text-lab-navy font-medium flex items-center gap-1 group-hover:underline">
                                查看详情 <i class="fa-solid fa-arrow-right text-[10px]"></i>
                            </span>
                        </div>
                    </div>

                    <div onclick="openProjectModal('project-2')" class="bg-white rounded-2xl p-6 border border-lab-border shadow-subtle hover:shadow-hover-card transition-all duration-300 cursor-pointer flex flex-col justify-between group">
                        <div class="space-y-4">
                            <div class="h-44 rounded-xl bg-slate-900 border border-slate-800 overflow-hidden relative flex items-center justify-center">
                                <img src="https://images.unsplash.com/photo-1634017839464-5c339ebe3cb4?q=80&w=800&auto=format&fit=crop"
                                     alt="AI 资料助手" class="w-full h-full object-cover opacity-90 group-hover:scale-105 transition-transform duration-500">
                                <div class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-white/90 backdrop-blur-sm text-[10px] font-mono font-medium text-lab-muted border border-slate-200">
                                    AI 应用
                                </div>
                            </div>

                            <div class="space-y-2">
                                <h3 class="text-base font-bold text-lab-text group-hover:text-lab-navy transition-colors">AI 资料助手</h3>

@media(max-width:680px){#kg-story .product-detail-cta{width:calc(100% - 32px);margin-bottom:48px;align-items:stretch;flex-direction:column}#kg-story .product-detail-cta .detail-entry-button{width:100%;white-space:normal}}

#kg-story .kg-product-entry{margin:28px 0 0;max-width:760px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px;padding:22px 26px;border-radius:18px;background:#1a2b4c;color:#fff;box-shadow:0 14px 32px rgba(15,23,42,.18)}#kg-story .kg-product-entry p{margin:0;color:rgba(255,255,255,.86);font-size:15px}#kg-story .kg-product-entry a{display:inline-flex;align-items:center;min-height:54px;padding:0 24px;border-radius:12px;background:#fff;color:#1a2b4c;font-size:16px;font-weight:750;text-decoration:none;transition:transform .2s,background .2s}#kg-story .kg-product-entry a:hover{background:#eff6ff;transform:translateY(-2px)}#kg-story .screenshot-slot{padding:0;overflow:hidden;background:#f7f8fa}@media(max-width:680px){#kg-story .kg-product-entry{margin:22px 0 0;padding:20px;align-items:stretch;flex-direction:column}#kg-story .kg-product-entry a{justify-content:center;width:100%;text-align:center}}</style><script>
  const storyRoot = document.querySelector('#kg-story');
  if (storyRoot) {
    const projectPanel = document.getElementById('timeline-project-keyguard');
    storyRoot.querySelectorAll('a[href^="#"]').forEach(link => {
      link.addEventListener('click', event => {
        if (!projectPanel) return;
        const target = document.getElementById(link.hash.slice(1));
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
        history.replaceState({ keyguardView: 'story' }, '', '/#section-projects');
      });
    });
    const revealItems = [...storyRoot.querySelectorAll('.reveal')];
    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, {
        root: document.querySelector('#timeline-project-keyguard'),
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px'
      });
      revealItems.forEach((item) => revealObserver.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    }
  }
</script>

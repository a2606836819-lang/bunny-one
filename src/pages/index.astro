    if (!rotatingText || !homeSection || reducedMotion) return;

    const phrases = [
        '一个不太安分的设计师',
        '一个技术探索者',
        '一个喜欢折腾的人',
        '一个对新鲜事物保持好奇的人'
    ];
    let phraseIndex = 0;
    let switching = false;

    window.setInterval(() => {
        if (document.hidden || homeSection.classList.contains('hidden') || switching) return;
        switching = true;
        rotatingText.classList.add('is-leaving');
        window.setTimeout(() => {
            phraseIndex = (phraseIndex + 1) % phrases.length;
            rotatingText.textContent = phrases[phraseIndex];
            rotatingText.classList.remove('is-leaving');
            rotatingText.classList.add('is-entering');
            switching = false;
        }, 380);
    }, 2800);

    rotatingText.addEventListener('animationend', event => {
        if (event.animationName === 'home-word-enter') rotatingText.classList.remove('is-entering');
    });
})();


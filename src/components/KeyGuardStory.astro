#kg-story .product-detail-cta .detail-entry-button { min-height:58px; flex:none; padding:0 26px; border:1px solid rgba(255,255,255,.24); background:#fff; color:var(--brand-navy); font-size:16px; font-weight:750; box-shadow:0 8px 24px rgba(0,0,0,.16); }

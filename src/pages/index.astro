function switchTab(tabId) {
    if (tabId !== 'projects') closeProjectDirectory();

    // 1. 隐藏所有页面
    document.querySelectorAll('.spa-section').forEach(section => {
        section.classList.add('hidden');
    });

    // 2. 找到这次要显示的页面
    const targetSection = document.getElementById(`section-${tabId}`);

    if (targetSection) {

        // 3. 先显示目标页面
        targetSection.classList.remove('hidden');

        // 4. 清除之前的动画类
        targetSection.classList.remove('page-enter');

        // 5. 强制浏览器重新计算布局
        // 这样浏览器才会知道动画需要重新开始
        void targetSection.offsetWidth;

        // 6. 添加动画类，触发进入效果
        targetSection.classList.add('page-enter');
        if (tabId === 'about') requestAnimationFrame(() => { window.dispatchEvent(new Event('resize')); targetSection.querySelector('#about-reader')?.dispatchEvent(new Event('scroll')); });
    }

    // 7. 更新左侧导航与滑动指示块
    document.querySelectorAll('aside .nav-item').forEach(btn => {
        const active = btn.getAttribute('data-tab') === tabId;
        btn.classList.toggle('active', active);
        if (active) moveNavIndicator(btn);
    });

    // 8. 切换页面时关闭手机菜单
    closeMobileDrawer();

    // 9. 页面滚动回顶部
    window.scrollTo({
        top: 0,
        behavior: 'smooth'
    });
}


